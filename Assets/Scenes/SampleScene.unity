  chapters:
  - id: ch1
    numeral: "\u4E00"
    title: "\u4EF2\u590F\u591C"
    english: Midsummer Night
    place: "\u4E03\u6708 \xB7 \u4EF2\u590F\u591C"
    quote: "\u201C\u4ECA\u5929\u662F\u4EF2\u590F\u591C\uFF0C\u4F60\u5FD8\u4E86\u5417\uFF1F\u6211\u4EEC\u8981\u53BB\u4F60\u7684\u7956\u7236\u5BB6\u3002\u201D"
    page: 003
    ordinal: first
  - id: ch2
    numeral: "\u4E8C"
    title: "\u6700\u9AD8\u7684\u5730\u65B9"
    english: The Highest Place
    place: "\u4E03\u6708 \xB7 \u7956\u7236\u5BB6\u7684\u8349\u5761"
    quote: "\u4ED6\u5FFD\u7136\u60F3\uFF0C\u8FD9\u5927\u6982\u5C31\u662F\u6700\u9AD8\u7684\u5730\u65B9\u3002"
    page: 011
    ordinal: second
  - id: ch3
    numeral: "\u4E09"
    title: "\u6298\u89D2"
    english: The Folded Corner
    place: "\u96E8\u5B63 \xB7 \u623F\u95F4"
    quote: "\u6709\u4E00\u5929\u4ED6\u5728\u6536\u62FE\u623F\u95F4\uFF0C\u4ECE\u67DC\u5B50\u5E95\u4E0B\u7FFB\u51FA\u4E00\u672C\u8FD8\u6298\u7740\u89D2\u7684\u4E66\u3002"
    page: 021
    ordinal: third
  - id: ch4
    numeral: "\u56DB"
    title: "\u9E1F\u7FA4"
    english: The Flock
    place: "\u68A6 \xB7 \u6CA1\u6709\u8FB9\u9645\u7684\u5929\u7A7A"
    quote: "\u98DE\u7FD4\u597D\u50CF\u548C\u8D70\u8DEF\u4E00\u6837\u7B80\u5355\u3002"
    page: 031
    ordinal: fourth
  - id: ch5
    numeral: "\u4E94"
    title: "\u5341\u4E00\u6708"
    english: November
    place: "\u5341\u4E00\u6708 \xB7 \u8349\u5761"
